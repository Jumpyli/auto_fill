{
  "manifest_version": 2,
  "name": "Apply Autofill",
  "version": "0.1.0",
  "description": "Fills job application forms from your own answer bank. Runs locally and never submits anything.",
  "browser_specific_settings": {
    "gecko": { "id": "apply-autofill@local", "strict_min_version": "115.0" }
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "<all_urls>"],
  "background": { "scripts": ["lib/defaults.js", "background/background.js"] },
  "browser_action": { "default_title": "Apply Autofill", "default_popup": "popup/popup.html" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["lib/match.js", "content/fill.js"]
    }
  ],
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Fill the application on this page"
    }
  }
}
